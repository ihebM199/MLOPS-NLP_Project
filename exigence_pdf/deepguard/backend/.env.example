# DeepGuard / Deepfake Adaptive Fusion API — configuration (12-factor).
# NOTE: the integrated Django backend reads `<project-root>/.env`
# (exigence_pdf/.env), NOT this directory. Copy these values there — or use
# the project-level `.env.example`, which already contains them.

# --- artefacts ---------------------------------------------------------
# Drop your TRAINED checkpoint here to replace the shipped CI dummy weights:
#   models/AdaptiveFusion_best_model.pth   (PyTorch, used by Grad-CAM)
#   models/deepfake_fusion.onnx            (ONNX, used by POST /predict)
#   models/model_config.json               (backbone, image size, ...)
MODEL_PATH=models/deepfake_fusion.onnx
PYTORCH_CHECKPOINT_PATH=models/AdaptiveFusion_best_model.pth
MODEL_CONFIG_PATH=models/model_config.json
METRICS_PATH=reports/metrics.json

# --- inference ---------------------------------------------------------
DECISION_THRESHOLD=0.5
MAX_UPLOAD_MB=10
ONNX_PROVIDERS=CPUExecutionProvider
ENABLE_GRADCAM=1
TORCH_DEVICE=auto

# --- HTTP --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8010,http://127.0.0.1:5173
LOG_LEVEL=INFO
MODEL_VERSION=1.0.0

# --- frontend / media / monitoring ------------------------------------
# Paths are resolved against the project root (the directory that contains
# `src/`, `models/`, `reports/` and `deepguard/`).
# Built React app served by Django when present (npm run build in
# deepguard/frontend). In dev, the Vite server (:5173) proxies the API.
FRONTEND_PATH=deepguard/frontend/dist/index.html
MEDIA_DIR=deepguard/backend/media
# JSONL prediction log + drift reports (Prometheus/Grafana consume /metrics).
MONITORING_DATA_DIR=monitoring_data
