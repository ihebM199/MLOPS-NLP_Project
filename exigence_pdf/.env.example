# ---------------------------------------------------------------------------
# Copy to `.env` (local) — on Colab use `google.colab.userdata` instead.
# NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Kaggle (dataset + source weights) -------------------------------------
# Preferred: a Kaggle API token (kaggle.com -> Settings -> API -> Create token)
KAGGLE_API_TOKEN=
# Legacy username/key pair (alternative to the token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Project layout --------------------------------------------------------
# Optional root override; defaults to the repository root.
DEEPFAKE_ROOT=
# Data / asset directories (absolute or relative to DEEPFAKE_ROOT)
DATA_DIR=
MODEL_DIR=models
REPORTS_DIR=reports
# Local DVC remote used by `dvc push` / `dvc pull`
DVC_REMOTE_URL=../dvc-remote

# --- MLflow ----------------------------------------------------------------
# Colab default: sqlite in ./mlruns (registry works, no server needed)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=deepfake-adaptive-fusion
MLFLOW_REGISTERED_MODEL=deepfake-adaptive-fusion

# --- Backend (FastAPI) -----------------------------------------------------
MODEL_PATH=models/deepfake_fusion.onnx
PYTORCH_CHECKPOINT_PATH=models/AdaptiveFusion_best_model.pth
MODEL_CONFIG_PATH=models/model_config.json
METRICS_PATH=reports/metrics.json
MAX_UPLOAD_MB=10
DECISION_THRESHOLD=0.5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
ENABLE_GRADCAM=true
TORCH_DEVICE=auto
FRONTEND_DIST=frontend/dist

# --- DeepGuard (Django stack) ---------------------------------------------
# Paths are relative to the project root. The Django backend reads this same
# `.env` file; the built React app and monitoring data live under `deepguard/`.
FRONTEND_PATH=deepguard/frontend/dist/index.html
MEDIA_DIR=deepguard/backend/media
MONITORING_DATA_DIR=monitoring_data

# --- Frontend (Vite) -------------------------------------------------------
# Empty = same origin (Colab single tunnel, nginx proxy, or local FastAPI)
VITE_API_URL=

# --- Colab / ngrok ---------------------------------------------------------
# Optional: expose the FastAPI + UI through a public URL
NGROK_AUTHTOKEN=
