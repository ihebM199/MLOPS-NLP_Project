# ---------------------------------------------------------------------------
# Data & model artefacts  (versioned with DVC, never with Git)
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/README.md
models/*
!models/.gitkeep
models/_archive/
mlruns/
mlartifacts/
reports/*
!reports/.gitkeep
# Small model card / evaluation metadata is safe to version (figures + weights are not).
!reports/metrics.json
archive/
frontend/public/examples/*.jpg
frontend/public/examples/*.png
frontend/dist/
dist/
.dvc/cache/
.dvc/tmp/
dvc-remote/

# ---------------------------------------------------------------------------
# Monitoring data (prediction logs, drift reports)
# ---------------------------------------------------------------------------
monitoring_data/
*.jsonl

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
kaggle.json
access_token
client_secret*.json
*.key
*.exe

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/
*.log

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn*.log
pnpm-debug.log*
.vite/

# ---------------------------------------------------------------------------
# OS / editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# LaTeX
# ---------------------------------------------------------------------------
rapport/*.aux
rapport/*.log
rapport/*.out
rapport/*.toc
rapport/*.bbl
rapport/*.blg
rapport/*.synctex.gz
rapport/*.fls
rapport/*.fdb_latexmk
